#cloud-config
# PROXMOX BACKUP SERVER profile.
# Same-host PBS gives this homelab a clean restore tier without putting
# Synology/NFS back into the Proxmox management plane.

hostname: ${hostname}
manage_etc_hosts: true

package_update: true
packages:
  - qemu-guest-agent
  - curl
  - wget
  - gnupg
  - apt-transport-https
  - ca-certificates
  - rsync
  # proxmox-backup-client is needed for DR restore drills (pxar restore from
  # a recovered datastore); pbs server packages alone do not ship it.
  - proxmox-backup-client

disable_root: false
users:
  - name: root
    ssh_authorized_keys:
      - ${ssh_pub_key}
  - name: ${admin_user}
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ${ssh_pub_key}

write_files:
  - path: /etc/apt/apt.conf.d/99force-ipv4
    permissions: "0644"
    content: |
      Acquire::ForceIPv4 "true";

  - path: /opt/pbs-data-disk-setup.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      LABEL="pbs-datastore"
      MOUNT_POINT="/srv/proxmox-backup-primary"

      ROOT_SOURCE="$(findmnt -n -o SOURCE /)"
      ROOT_DISK="/dev/$(lsblk -no PKNAME "$${ROOT_SOURCE}")"
      mapfile -t DATA_DISKS < <(
        lsblk -dnpo NAME,TYPE \
          | awk '$2 == "disk" { print $1 }' \
          | grep -vx "$${ROOT_DISK}"
      )

      if [ "$${#DATA_DISKS[@]}" -ne 1 ]; then
        echo "ERROR: expected exactly one non-root PBS data disk, found: $${DATA_DISKS[*]:-none}"
        exit 1
      fi

      DISK="$${DATA_DISKS[0]}"

      for i in $(seq 1 30); do
        if [ -b "$DISK" ]; then
          break
        fi
        sleep 2
      done

      if [ ! -b "$DISK" ]; then
        echo "ERROR: $DISK not found after waiting 60s"
        exit 1
      fi

      CURRENT_LABEL="$(blkid -s LABEL -o value "$${DISK}" 2>/dev/null || true)"

      if ! blkid "$${DISK}" > /dev/null 2>&1; then
        mkfs.ext4 -F -L "$LABEL" "$${DISK}"
        CURRENT_LABEL="$LABEL"
      elif [ "$${CURRENT_LABEL:-}" != "$LABEL" ]; then
        tune2fs -L "$LABEL" "$${DISK}"
        CURRENT_LABEL="$LABEL"
      fi

      mkdir -p "$MOUNT_POINT"
      awk '$2 != "/srv/proxmox-backup-primary" { print }' /etc/fstab > /etc/fstab.tmp
      echo "LABEL=$LABEL $MOUNT_POINT ext4 defaults,nofail 0 2" >> /etc/fstab.tmp
      mv /etc/fstab.tmp /etc/fstab

      if ! mountpoint -q "$MOUNT_POINT"; then
        mount "$MOUNT_POINT"
      fi

      mkdir -p "$${MOUNT_POINT}/datastore"

  - path: /opt/pbs-install.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      apt_retry() {
        local attempt
        for attempt in 1 2 3 4 5; do
          if "$@"; then
            return 0
          fi
          sleep $((attempt * 5))
        done
        return 1
      }

      install -d -m 0755 /etc/apt/keyrings
      curl -fsSL https://enterprise.proxmox.com/debian/proxmox-release-trixie.gpg -o /etc/apt/keyrings/proxmox-release-trixie.gpg
      chmod 0644 /etc/apt/keyrings/proxmox-release-trixie.gpg

      rm -f /etc/apt/sources.list.d/pbs-enterprise.list /etc/apt/sources.list.d/pbs-enterprise.sources
      cat > /etc/apt/sources.list.d/pbs-install-repo.list <<'EOF'
      deb [signed-by=/etc/apt/keyrings/proxmox-release-trixie.gpg] http://download.proxmox.com/debian/pbs trixie pbs-no-subscription
      EOF

      export DEBIAN_FRONTEND=noninteractive
      apt_retry apt-get update -qq -o Acquire::ForceIPv4=true
      apt_retry apt-get install -y -o Acquire::ForceIPv4=true --fix-missing proxmox-backup-server rsync

  - path: /opt/pbs-bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      DATASTORE_NAME="primary"
      DATASTORE_PATH="/srv/proxmox-backup-primary/datastore"

      if ! command -v proxmox-backup-manager >/dev/null 2>&1; then
        echo "ERROR: proxmox-backup-manager is not installed"
        exit 1
      fi

      if ! proxmox-backup-manager datastore list --output-format json | python3 -c 'import json, sys; name = sys.argv[1]; items = json.load(sys.stdin); sys.exit(0 if any(item.get("name") == name for item in items) else 1)' "$DATASTORE_NAME"
      then
        proxmox-backup-manager datastore create "$DATASTORE_NAME" "$DATASTORE_PATH"
      fi

runcmd:
  - [systemctl, enable, qemu-guest-agent]
  - [systemctl, start, qemu-guest-agent]
  - [bash, -lc, "/opt/pbs-install.sh"]
  - [bash, -lc, "/opt/pbs-data-disk-setup.sh"]
  - [bash, -lc, "/opt/pbs-bootstrap.sh"]

power_state:
  mode: reboot
  condition: true
  delay: 5
